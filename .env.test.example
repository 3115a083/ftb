# Generate with: openssl rand -hex 24
DB_PASSWORD=
# Optional. Without a bot, the website runs read-only and initially has no data.
# Use a separate test bot if another installation is already polling your live bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Only the first start uses INSTANCE_MODE. Later changes are made in the bot.
INSTANCE_MODE=classic
TEST_BIND_IP=127.0.0.1
TEST_PORT=3080
SITE_URL=http://localhost:3080
# Test HTTP only. For public access: HTTPS SITE_URL and ALLOW_HTTP_TEST=0.
ALLOW_HTTP_TEST=1
# Enable only behind one trusted reverse proxy; restrict direct network access.
TRUST_PROXY=0
